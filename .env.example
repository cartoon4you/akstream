# Gemini API Key (Server-side)
GEMINI_API_KEY=

# Firebase Client API Key (optional override)
FIREBASE_API_KEY=

# Akwam Base URL for scraping
AKWAM_BASE_URL=

# Allowed hosts/domains for video streaming proxy (comma-separated, e.g. .downet.net)
STREAM_ALLOWED_HOSTS=

# Custom User-Agent for scraper & streaming requests
SCRAPER_USER_AGENT=
